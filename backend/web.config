<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <iisnode node_env="production" loggingEnabled="true" devErrorsEnabled="false" enableXFF="true" nodeProcessCountPerApplication="1" watchedFiles="*.js;node_modules\*;*.json" promoteServerVars="REMOTE_USER,LOGON_USER,AUTH_USER" />

    <handlers>
      <clear />
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <rewrite>
      <rules>
        <clear />
        <rule name="Node Backend" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
            <authentication>
                <windowsAuthentication enabled="false" />
            </authentication>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-store" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <webSocket enabled="false" />
  </system.webServer>
    <system.web>
        <sessionState cookieless="AutoDetect" />
    </system.web>
</configuration>
